# Scheduler automatique des rappels de deadlines.
# Actif par défaut. Mets false pour désactiver temporairement.
DEADLINE_REMINDER_ENABLED=true

# Intervalle de scan en secondes. Minimum forcé dans le code : 60.
# 900 = toutes les 15 minutes.
DEADLINE_REMINDER_INTERVAL_SECONDS=900

# Optionnel mais recommandé si tu veux appeler POST /deadlines/reminders/run.
# En production, l'endpoint manuel est refusé si ce token n'est pas défini.
DEADLINE_REMINDER_ADMIN_TOKEN=
