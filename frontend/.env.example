# Traduction dynamique optionnelle.
# Sans cette URL, K-Planner traduit seulement les textes UI connus via dictionnaire local.
#
# LibreTranslate compatible:
# VITE_TRANSLATION_PROVIDER=libretranslate
# VITE_TRANSLATION_API_URL=http://localhost:5000/translate
#
# Proxy backend maison / OpenAI / DeepL compatible:
# VITE_TRANSLATION_PROVIDER=generic
# VITE_TRANSLATION_API_URL=http://localhost:8000/translate
# VITE_TRANSLATION_API_KEY=
